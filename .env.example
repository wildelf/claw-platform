# Frontend
VITE_API_URL=/api
VITE_APP_TITLE=Claw Platform

# Backend secrets - copy to .env and fill in your actual values
# JWT secret - use a strong random string (at least 32 chars)
CLAW_JWT_SECRET=

# Default model API key
CLAW_MODEL_API_KEY=

# Web search API key (if using MiniMax or similar)
CLAW_WEB_SEARCH_API_KEY=
